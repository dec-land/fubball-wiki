<div class="site-title-group">
	<button
		type="button"
		class="sidebar-toggle"
		data-sidebar-toggle
		aria-label="Toggle sidebar"
		aria-expanded="true"
		title="Hide sidebar"
	>
		<svg
			width="16"
			height="16"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<rect width="18" height="18" x="3" y="3" rx="2"></rect>
			<path d="M9 3v18"></path>
		</svg>
	</button>
	<a href="/" class="site-title">
		<span class="wordmark">FUBBALL WIKI</span>
	</a>
</div>

<script>
	const STORAGE_KEY = "fubball-wiki-sidebar-hidden";
	const root = document.documentElement;
	const button = document.querySelector<HTMLButtonElement>("[data-sidebar-toggle]");

	const syncButton = () => {
		if (!button) return;
		const isHidden = root.dataset.sidebarHidden === "true";
		button.setAttribute("aria-expanded", String(!isHidden));
		button.setAttribute("title", isHidden ? "Show sidebar" : "Hide sidebar");
	};

	if (button) {
		syncButton();
		button.addEventListener("click", () => {
			const nextHidden = root.dataset.sidebarHidden !== "true";
			if (nextHidden) {
				root.dataset.sidebarHidden = "true";
			} else {
				delete root.dataset.sidebarHidden;
			}
			try {
				localStorage.setItem(STORAGE_KEY, String(nextHidden));
			} catch {}
			syncButton();
		});
	}
</script>

<style>
	.site-title-group {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
	}

	.sidebar-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 1.875rem;
		height: 1.875rem;
		padding: 0;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.375rem;
		background: transparent;
		color: var(--sl-color-gray-3);
		cursor: pointer;
		transition:
			color 150ms ease,
			border-color 150ms ease,
			background-color 150ms ease;
	}

	.sidebar-toggle:hover,
	.sidebar-toggle:focus-visible {
		color: var(--sl-color-white);
		border-color: var(--sl-color-gray-4);
		background: var(--fubball-surface-elevated);
	}

	@media (min-width: 50rem) {
		.sidebar-toggle {
			display: inline-flex;
		}
	}

	.site-title {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--sl-color-text);
		font-family: var(--fubball-font-mono);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.site-title:hover {
		color: var(--sl-color-white);
	}
</style>
